# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase Dashboard -> Project Settings -> API Keys)

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only (Project Settings -> API Keys -> secret key). Never prefix this
# with NEXT_PUBLIC_ - that would ship it to the browser. Used only by
# lib/supabase/admin.ts, for creating/resetting staff logins.
SUPABASE_SECRET_KEY=your-secret-key
